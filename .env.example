# ==============================================================================
# ResQGrid Environment Configuration (.env.example)
# Copy this file to .env and customize values for your local environment.
# Never commit the actual .env file with secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Frontend Public Configuration (Used by Vite)
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000

# PostgreSQL with PostGIS Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resqgrid
POSTGRES_USER=resqgrid_user
POSTGRES_PASSWORD=resqgrid_password
DATABASE_URL=postgresql://resqgrid_user:resqgrid_password@localhost:5432/resqgrid

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=24h

# External Disaster Data Ingestion
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
USGS_TIMEOUT_MS=5000
INGESTION_INTERVAL_MS=120000
ENABLE_INGESTION_CRON=true

# Logging
LOG_LEVEL=info
