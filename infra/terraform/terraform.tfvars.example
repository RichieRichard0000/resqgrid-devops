# ==============================================================================
# Terraform Variables Example
# Project: ResQGrid — Real-Time Disaster Alert & Response Platform
# Copy this file to terraform.tfvars and fill in your custom values:
# cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

# AWS Region (ap-south-1 Mumbai is standard for SRMIST Chennai)
aws_region = "ap-south-1"

# Environment identifier
environment = "staging"

# Network CIDRs
vpc_cidr            = "10.0.0.0/16"
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
availability_zone   = "ap-south-1a"

# Compute: t3.medium provides 2 vCPU and 4 GiB memory (sweet spot for k3s + backend + frontend + postgis)
instance_type    = "t3.medium"
root_volume_size = 30

# Optional EC2 SSH Key Pair name (leave empty if using AWS SSM Session Manager)
# key_name = "resqgrid-devops-key"

# Restrict management access to your team's public IP range (recommended: "203.0.113.50/32")
admin_cidr_blocks = [
  "0.0.0.0/0" # WARNING: Replace with your specific IP range for production
]

# ECR Repositories
backend_repo_name  = "resqgrid-backend"
frontend_repo_name = "resqgrid-frontend"
